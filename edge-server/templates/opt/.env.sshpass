{% if middleware_sudo_password %}
MIDDLEWARE_SERVER_SUDO_PASSWORD={{ middleware_sudo_password }}
{% endif %}
{% if middleware_ssh_password %}
MIDDLEWARE_SERVER_SSH_PASSWORD={{ middleware_ssh_password }}
{% endif %}
{% if viewer_sudo_password %}
VIEWER_SERVER_SUDO_PASSWORD={{ viewer_sudo_password }}
{% endif %}
{% if viewer_ssh_password %}
VIEWER_SERVER_SSH_PASSWORD={{ viewer_ssh_password }}
{% endif %}
